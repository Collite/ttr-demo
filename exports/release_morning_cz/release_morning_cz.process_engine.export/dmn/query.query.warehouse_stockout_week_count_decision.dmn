<?xml version="1.0" encoding="UTF-8"?>
<definitions id="query.query.warehouse_stockout_week_count_decision_definitions" name="query.query.warehouse_stockout_week_count" namespace="https://tatrman.org/dmn/hartland.worlds.demo" xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn">
  <decision camunda:historyTimeToLive="30" id="query.query.warehouse_stockout_week_count_decision" name="query.query.warehouse_stockout_week_count_decision">
    <decisionTable hitPolicy="FIRST" id="query.query.warehouse_stockout_week_count_decision_table">
      <input id="query.query.warehouse_stockout_week_count_decision_input_0" label="warehouse">
        <inputExpression id="query.query.warehouse_stockout_week_count_decision_expression_0" typeRef="string">
          <text>warehouse</text>
        </inputExpression>
      </input>
      <input id="query.query.warehouse_stockout_week_count_decision_input_1" label="stockout_weeks">
        <inputExpression id="query.query.warehouse_stockout_week_count_decision_expression_1" typeRef="number">
          <text>stockout_weeks</text>
        </inputExpression>
      </input>
      <input id="query.query.warehouse_stockout_week_count_decision_input_2" label="first_week">
        <inputExpression id="query.query.warehouse_stockout_week_count_decision_expression_2" typeRef="number">
          <text>first_week</text>
        </inputExpression>
      </input>
      <input id="query.query.warehouse_stockout_week_count_decision_input_3" label="last_week">
        <inputExpression id="query.query.warehouse_stockout_week_count_decision_expression_3" typeRef="number">
          <text>last_week</text>
        </inputExpression>
      </input>
      <input id="query.query.warehouse_stockout_week_count_decision_input_4" label="row_count">
        <inputExpression id="query.query.warehouse_stockout_week_count_decision_expression_4" typeRef="number">
          <text>row_count</text>
        </inputExpression>
