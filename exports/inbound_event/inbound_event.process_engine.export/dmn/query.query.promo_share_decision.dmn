<?xml version="1.0" encoding="UTF-8"?>
<definitions id="query.query.promo_share_decision_definitions" name="query.query.promo_share" namespace="https://tatrman.org/dmn/hartland.worlds.demo" xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn">
  <decision camunda:historyTimeToLive="30" id="query.query.promo_share_decision" name="query.query.promo_share_decision">
    <decisionTable hitPolicy="FIRST" id="query.query.promo_share_decision_table">
      <input id="query.query.promo_share_decision_input_0" label="promo_revenue">
        <inputExpression id="query.query.promo_share_decision_expression_0" typeRef="number">
          <text>promo_revenue</text>
        </inputExpression>
      </input>
      <input id="query.query.promo_share_decision_input_1" label="total_revenue">
        <inputExpression id="query.query.promo_share_decision_expression_1" typeRef="number">
          <text>total_revenue</text>
        </inputExpression>
      </input>
      <input id="query.query.promo_share_decision_input_2" label="promo_share_pct">
        <inputExpression id="query.query.promo_share_decision_expression_2" typeRef="number">
          <text>promo_share_pct</text>
        </inputExpression>
      </input>
      <input id="query.query.promo_share_decision_input_3" label="row_count">
        <inputExpression id="query.query.promo_share_decision_expression_3" typeRef="number">
          <text>row_count</text>
        </inputExpression>
      </input>
      <output id="query.query.promo_share_decision_output" name="outcome" typeRef="string" />
    </decisionTable>
  </decision>
</definitions>

