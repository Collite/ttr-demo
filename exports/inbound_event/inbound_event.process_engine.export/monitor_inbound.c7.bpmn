    <bpmn:subProcess id="n_b043b4498f46ca270b65" name="inbound_on_receipt">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="ttrOpenBody">${S('{}').prop(&quot;deployment&quot;,&quot;inbound_event&quot;).prop(&quot;port&quot;,S('{}').prop(&quot;key&quot;,ttrInput['key']).prop('at', ttrInput['at'] != null ? ttrInput['at'] : dateTime().toString())).prop(&quot;origin&quot;,&quot;engine&quot;).prop(&quot;dryRun&quot;,false).prop(&quot;engine&quot;,S('{}').prop(&quot;instanceId&quot;,execution.processInstanceId).prop(&quot;businessKey&quot;,execution.processBusinessKey).prop(&quot;deploymentId&quot;,execution.processEngineServices.repositoryService.getProcessDefinition(execution.processDefinitionId).deploymentId)).prop(&quot;recipeFingerprint&quot;,&quot;sha256:664a8a9564a31cf45c7ee7615f83c3fc41a28f1ce30f13582af20da7223ad663&quot;).prop(&quot;recipeValuesFingerprint&quot;,&quot;sha256:dba014c020bb1d09dabb29c7914b17cb6715a5be874a1f51bcd8e1e98d018c05&quot;).prop(&quot;programFingerprint&quot;,&quot;sha256:8f0cdfb27056eea519f503f197f32e4a69b77df530083ec042d965f8345c4c47&quot;).prop(&quot;deploymentFingerprint&quot;,&quot;sha256:a2ab8f214b6040afea3f13ec60c658d8a305ac073c1711574b9ac06523db96e5&quot;)}</camunda:inputParameter>
          <camunda:outputParameter name="ttrPreviousRunId">${execution.getVariable('ttrOpen') != null ? ttrOpen.prop(&quot;runId&quot;).stringValue() : null}</camunda:outputParameter>
          <camunda:outputParameter name="ttrAnchor">${execution.getVariable('ttrOpen') != null ? ttrOpen.prop(&quot;runId&quot;).stringValue() : null}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>n_2665cd8f636830b4714a</bpmn:incoming>
