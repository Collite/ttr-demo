        </bpmn:startEvent>
        <bpmn:endEvent id="n_82d2a9cf120f0b19fed4" name="handle settled">
          <bpmn:incoming>n_da4d37d64a3918e8241d</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:intermediateCatchEvent id="n_43b0a777aa66b432cda8" name="honour Retry-After">
          <bpmn:incoming>n_55867626641e050fcc86</bpmn:incoming>
          <bpmn:incoming>n_43aff7994387a52945a9</bpmn:incoming>
          <bpmn:outgoing>n_6b0e635b895ee3a7f295</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>${'PT'.concat(ttrHandleRetryAfter.toString()).concat('S')}</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:serviceTask camunda:asyncBefore="true" id="n_d675616eab4012f8066c" name="handle status">
          <bpmn:extensionElements>
            <camunda:connector>
              <camunda:connectorId>http-connector</camunda:connectorId>
              <camunda:inputOutput>
