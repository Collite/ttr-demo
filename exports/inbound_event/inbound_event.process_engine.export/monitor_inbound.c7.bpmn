            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ttrPage.hasProp('rows') &amp;&amp; ttrPage.prop('rows').isArray() &amp;&amp; ttrPage.prop('rowCount').numberValue() == ttrExpectedRows &amp;&amp; ttrPage.prop('rows').elements().size() &gt; 0 &amp;&amp; ttrPage.prop('rows').elements().size() + ttrPageState.prop('offset').numberValue() &lt;= ttrExpectedRows}</bpmn:conditionExpression>
