ot;,&quot;path&quot;:&quot;/automation/runs/{id}&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{}},{&quot;task&quot;:&quot;n_e9d669ee3cda2ff0b3b2&quot;,&quot;name&quot;:&quot;route&quot;,&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/routes/complete&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;route&quot;:&quot;complete&quot;}},{&quot;task&quot;:&quot;n_3958c51de94f65221681&quot;,&quot;name&quot;:&quot;perform&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/actions/fulfil/perform&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;action&quot;:&quot;fulfil&quot;}},{&quot;task&quot;:&quot;n_da8a1d07a7c4f99258c5&quot;,&quot;name&quot;:&quot;perform&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/actions/set_state/perform&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;action&quot;:&quot;set_state&quot;}},{&quot;task&quot;:&quot;n_63a426e3bdcd250c4e2c&quot;,&quot;name&quot;:&quot;perform&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/actions/expect/perform&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;action&quot;:&quot;expect&quot;}},{&quot;task&quot;:&quot;n_f7a20a14fcb5f8446557&quot;,&quot;name&quot;:&quot;route&quot;,&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/routes/damaged&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;route&quot;:&quot;damaged&quot;}},{&quot;task&quot;:&quot;n_92a3f8df2b94fd8d40fd&quot;,&quot;name&quot;:&quot;route&quot;,&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/routes/expired&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;route&quot;:&quot;expired&quot;}},{&quot;task&quot;:&quot;n_295dfefdcd01247ac0c1&quot;,&quot;name&quot;:&quot;perform&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/actions/fulfil/perform&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;action&quot;:&quot;fulfil&quot;}},{&quot;task&quot;:&quot;n_9a63a97084d9b51dd90a&quot;,&quot;name&quot;:&quot;perform&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/actions/set_state/perform&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;action&quot;:&quot;set_state&quot;}},{&quot;task&quot;:&quot;n_c325315e00e99d9f492c&quot;,&quot;name&quot;:&quot;route&quot;,&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/routes/remind&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;route&quot;:&quot;remind&quot;}},{&quot;task&quot;:&quot;n_e2811d4e8a1debcb3437&quot;,&quot;name&quot;:&quot;outcome&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/actions/notify_customer/outcome&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{&quot;action&quot;:&quot;notify_customer&quot;}},{&quot;task&quot;:&quot;n_820d3b939cdb28515b49&quot;,&quot;name&quot;:&quot;close&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/close&quot;,&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;program&quot;:&quot;inbound_on_receipt&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{}}],&quot;routes&quot;:[{&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;route&quot;:&quot;complete&quot;,&quot;flow&quot;:&quot;n_b77e647e3c6499f20bd5&quot;,&quot;gateway&quot;:&quot;n_d1f4919cf3efed5ca35d&quot;,&quot;entry&quot;:&quot;n_b2ddf4801f67fb14fead&quot;,&quot;task&quot;:&quot;n_e9d669ee3cda2ff0b3b2&quot;},{&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;route&quot;:&quot;damaged&quot;,&quot;flow&quot;:&quot;n_0eef615f555de5eb5e0f&quot;,&quot;gateway&quot;:&quot;n_d1f4919cf3efed5ca35d&quot;,&quot;entry&quot;:&quot;n_245e80243003c4947f9d&quot;,&quot;task&quot;:&quot;n_f7a20a14fcb5f8446557&quot;},{&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;route&quot;:&quot;expired&quot;,&quot;flow&quot;:&quot;n_f6b07356ac3b8f2b5e0f&quot;,&quot;gateway&quot;:&quot;n_d1f4919cf3efed5ca35d&quot;,&quot;entry&quot;:&quot;n_266de64e8c62f2f96303&quot;,&quot;task&quot;:&quot;n_92a3f8df2b94fd8d40fd&quot;},{&quot;recipe&quot;:&quot;monitor_inbound&quot;,&quot;route&quot;:&quot;remind&quot;,&quot;flow&quot;:&quot;n_baf0320f644426604ede&quot;,&quot;gateway&quot;:&quot;n_d1f4919cf3efed5ca35d&quot;,&quot;entry&quot;:&quot;n_1780b596f934052bd346&quot;,&quot;task&quot;:&quot;n_c325315e00e99d9f492c&quot;}]}</ttr:contract>
    </bpmn:extensionElements>
