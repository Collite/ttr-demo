      <bpmn:subProcess id="n_1d180030b26200428275" name="await other execution">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="ttrHandleRetryAfter">${ttrOpenRetryAfter}</camunda:inputParameter>
            <camunda:outputParameter name="ttrHandle">${ttrHandle}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>n_52f0e8390238107847f9</bpmn:incoming>
        <bpmn:outgoing>n_ec3d3be8cc612b168566</bpmn:outgoing>
        <bpmn:startEvent id="n_cd37704b19ebbb5c4362" name="handle start">
