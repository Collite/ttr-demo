<?xml version="1.0" encoding="UTF-8"?>
<definitions id="query.query.warehouse_stockout_weeks_decision_definitions" name="query.query.warehouse_stockout_weeks" namespace="https://tatrman.org/dmn/hartland.worlds.demo" xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn">
  <decision camunda:historyTimeToLive="30" id="query.query.warehouse_stockout_weeks_decision" name="query.query.warehouse_stockout_weeks_decision">
    <decisionTable hitPolicy="FIRST" id="query.query.warehouse_stockout_weeks_decision_table">
      <input id="query.query.warehouse_stockout_weeks_decision_input_0" label="warehouse">
        <inputExpression id="query.query.warehouse_stockout_weeks_decision_expression_0" typeRef="string">
          <text>warehouse</text>
        </inputExpression>
      </input>
      <input id="query.query.warehouse_stockout_weeks_decision_input_1" label="d_week_seq">
        <inputExpression id="query.query.warehouse_stockout_weeks_decision_expression_1" typeRef="number">
          <text>d_week_seq</text>
        </inputExpression>
      </input>
      <input id="query.query.warehouse_stockout_weeks_decision_input_2" label="zero_rows">
        <inputExpression id="query.query.warehouse_stockout_weeks_decision_expression_2" typeRef="number">
          <text>zero_rows</text>
        </inputExpression>
      </input>
      <input id="query.query.warehouse_stockout_weeks_decision_input_3" label="total_rows">
        <inputExpression id="query.query.warehouse_stockout_weeks_decision_expression_3" typeRef="number">
          <text>total_rows</text>
        </inputExpression>
      </input>
      <input id="query.query.warehouse_stockout_weeks_decision_input_4" label="row_count">
        <inputExpression id="query.query.warehouse_stockout_weeks_decision_expression_4" typeRef="number">
          <text>row_count</text>
        </inputExpression>
      </input>
      <output id="query.query.warehouse_stockout_weeks_decision_output" name="outcome" typeRef="string" />
    </decisionTable>
  </decision>
</definitions>

