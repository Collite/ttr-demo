<?xml version="1.0" encoding="UTF-8"?>
<definitions id="query.query.inventory_on_hand_series_decision_definitions" name="query.query.inventory_on_hand_series" namespace="https://tatrman.org/dmn/hartland.worlds.demo" xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn">
  <decision camunda:historyTimeToLive="30" id="query.query.inventory_on_hand_series_decision" name="query.query.inventory_on_hand_series_decision">
    <decisionTable hitPolicy="FIRST" id="query.query.inventory_on_hand_series_decision_table">
      <input id="query.query.inventory_on_hand_series_decision_input_0" label="warehouse">
        <inputExpression id="query.query.inventory_on_hand_series_decision_expression_0" typeRef="string">
          <text>warehouse</text>
        </inputExpression>
      </input>
      <input id="query.query.inventory_on_hand_series_decision_input_1" label="d_week_seq">
        <inputExpression id="query.query.inventory_on_hand_series_decision_expression_1" typeRef="number">
          <text>d_week_seq</text>
        </inputExpression>
      </input>
      <input id="query.query.inventory_on_hand_series_decision_input_2" label="on_hand_qty">
        <inputExpression id="query.query.inventory_on_hand_series_decision_expression_2" typeRef="number">
          <text>on_hand_qty</text>
        </inputExpression>
      </input>
      <input id="query.query.inventory_on_hand_series_decision_input_3" label="row_count">
        <inputExpression id="query.query.inventory_on_hand_series_decision_expression_3" typeRef="number">
          <text>row_count</text>
        </inputExpression>
      </input>
      <output id="query.query.inventory_on_hand_series_decision_output" name="outcome" typeRef="string" />
    </decisionTable>
  </decision>
</definitions>

