                    <camunda:map>
                      <camunda:entry key="Content-Type">application/json</camunda:entry>
                    </camunda:map>
                  </camunda:inputParameter>
                  <camunda:outputParameter name="ttrPage">
                    <camunda:script scriptFormat="groovy">def BpmnError; try { BpmnError = Class.forName('org.cibseven.bpm.engine.delegate.BpmnError') } catch (ClassNotFoundException e) { BpmnError = Class.forName('org.camunda.bpm.engine.delegate.BpmnError') }&#10;def code = ((Number) statusCode).intValue()&#10;if (code == 409) throw BpmnError.getConstructor(String, String).newInstance('TTR_STALE', 'run API fingerprint refused')&#10;if (code &gt;= 400 &amp;&amp; code &lt; 500 &amp;&amp; code != 408 &amp;&amp; code != 429) throw BpmnError.getConstructor(String, String).newInstance('TTR_REFUSED', 'run API HTTP ' + code + ': ' + response.toString().take(256))&#10;if (code &lt; 200 || code &gt;= 300) throw new IllegalStateException('run API HTTP ' + code)&#10;def SpinClass; try { SpinClass = Class.forName('org.cibseven.spin.Spin') } catch (ClassNotFoundException e) { SpinClass = Class.forName('org.camunda.spin.Spin') }&#10;return SpinClass.JSON(response)</camunda:script>
                  </camunda:outputParameter>
                  <camunda:outputParameter name="ttrPageCode">${statusCode}</camunda:outputParameter>
                  <camunda:outputParameter name="ttrPageHeaders">${headers}</camunda:outputParameter>
                  <camunda:outputParameter name="ttrPageRetryAfter">
                    <camunda:script scriptFormat="groovy">def value = headers['retry-after'] ?: headers['Retry-After']&#10;try {&#10;    def seconds = new BigDecimal(value.toString())&#10;    return seconds &gt; 0 ? seconds : 15&#10;} catch (Exception ignored) {&#10;    try {&#10;        def instant = java.time.ZonedDateTime.parse(value.toString(), java.time.format.DateTimeFormatter.RFC_1123_DATE_TIME).toInstant()&#10;        return Math.max(1L, (long) Math.ceil(java.time.Duration.between(java.time.Instant.now(), instant).toMillis() / 1000.0))&#10;    } catch (Exception absent) { return 15 }&#10;}</camunda:script>
