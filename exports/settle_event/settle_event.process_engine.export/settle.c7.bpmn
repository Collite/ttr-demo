    <bpmn:subProcess id="n_d800516885321f8813c6" name="settle_on_document">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="ttrOpenBody">${S('{}').prop(&quot;deployment&quot;,&quot;settle_event&quot;).prop(&quot;port&quot;,S('{}').prop(&quot;key&quot;,ttrInput['key']).prop('at', ttrInput['at'] != null ? ttrInput['at'] : dateTime().toString())).prop(&quot;origin&quot;,&quot;engine&quot;).prop(&quot;dryRun&quot;,false).prop(&quot;engine&quot;,S('{}').prop(&quot;instanceId&quot;,execution.processInstanceId).prop(&quot;businessKey&quot;,execution.processBusinessKey).prop(&quot;deploymentId&quot;,execution.processEngineServices.repositoryService.getProcessDefinition(execution.processDefinitionId).deploymentId)).prop(&quot;recipeFingerprint&quot;,&quot;sha256:a9ab9c3d1112d6ed0e722c4f9f24a6d588e33f764fcfd75a2a0f1ad0d841ce0b&quot;).prop(&quot;recipeValuesFingerprint&quot;,&quot;sha256:26cd4bbbdef5ad8c69ea41324530ab1e48a37ff0a1a73819a49ce3c729d82016&quot;).prop(&quot;programFingerprint&quot;,&quot;sha256:4f8bce753560b48393e0cb9697613bed66570e058a5fc8e8fb49d6d5902c2083&quot;).prop(&quot;deploymentFingerprint&quot;,&quot;sha256:a6c80f90a1cdf2a8419839b17ec954f7d269076ae577e1ce930b2300931a3db7&quot;)}</camunda:inputParameter>
          <camunda:outputParameter name="ttrPreviousRunId">${execution.getVariable('ttrOpen') != null ? ttrOpen.prop(&quot;runId&quot;).stringValue() : null}</camunda:outputParameter>
          <camunda:outputParameter name="ttrAnchor">${execution.getVariable('ttrOpen') != null ? ttrOpen.prop(&quot;runId&quot;).stringValue() : null}</camunda:outputParameter>
        </camunda:inputOutput>
