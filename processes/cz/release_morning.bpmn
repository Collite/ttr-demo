          <bpmn:scriptTask id="n_257640b018094d372360" name="append hold_sales page" scriptFormat="groovy">
            <bpmn:incoming>n_c1d46e423a61d8ce96e6</bpmn:incoming>
            <bpmn:outgoing>n_fe896a5897f0c3936cf3</bpmn:outgoing>
            <bpmn:script>def state = execution.getVariable('ttrPageState')
def page = execution.getVariable('ttrPage')
def values = page.prop('rows').elements()
values.each { state.prop('rows').append(it) }
state.prop('offset', state.prop('offset').numberValue().longValue() + values.size())
if (state.prop('size').numberValue().longValue() == 0) state.prop('size', values.size())
state.prop('reads', state.prop('reads').numberValue().longValue() + 1)
execution.setVariable('ttrPageState', state)</bpmn:script>
          </bpmn:scriptTask>
