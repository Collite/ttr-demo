          <bpmn:serviceTask id="s41_release_confirmed_perform" name="Zadržet objednávku pro obchod" camunda:asyncBefore="true">
            <bpmn:extensionElements>
              <camunda:connector>
                <camunda:connectorId>http-connector</camunda:connectorId>
                <camunda:inputOutput>
                  <camunda:inputParameter name="method">POST</camunda:inputParameter>
                  <camunda:inputParameter name="url">${"http://process-engine-egress.process-engine.svc/automation/deployments/release_morning_cz/actions/hold/perform"}</camunda:inputParameter>
                  <camunda:inputParameter name="headers">
                    <camunda:map>
                      <camunda:entry key="Content-Type">application/json</camunda:entry>
                    </camunda:map>
                  </camunda:inputParameter>
                  <camunda:inputParameter name="payload">${S('{}').prop("key", S('{}').prop("order", ttrRow.prop("order_number"))).prop("params", S('{}').prop("department", "Sales")).prop("origin", "engine").prop("idempotencyKey", execution.processInstanceId.concat(":lapsed:").concat(ttrRow.prop("order_number").toString())).toString()}</camunda:inputParameter>
                  <camunda:outputParameter name="ttrLapsed">
                    <camunda:script scriptFormat="groovy">def BpmnError; try { BpmnError = Class.forName('org.cibseven.bpm.engine.delegate.BpmnError') } catch (ClassNotFoundException e) { BpmnError = Class.forName('org.camunda.bpm.engine.delegate.BpmnError') }
def code = ((Number) statusCode).intValue()
if (code == 409) throw BpmnError.getConstructor(String, String).newInstance('TTR_STALE', 'perform hold after the lapse: HTTP 409')
if (code &gt;= 400 &amp;&amp; code &lt; 500 &amp;&amp; code != 408 &amp;&amp; code != 429) throw BpmnError.getConstructor(String, String).newInstance('TTR_REFUSED', 'perform hold after the lapse: HTTP ' + code + ': ' + response.toString().take(256))
if (code &lt; 200 || code &gt;= 300) throw new IllegalStateException('perform hold after the lapse: HTTP ' + code)
def SpinClass; try { SpinClass = Class.forName('org.cibseven.spin.Spin') } catch (ClassNotFoundException e) { SpinClass = Class.forName('org.camunda.spin.Spin') }
return SpinClass.JSON(response)
</camunda:script>
                  </camunda:outputParameter>
                  <camunda:outputParameter name="ttrLapsedCode">${statusCode}</camunda:outputParameter>
                </camunda:inputOutput>
              </camunda:connector>
              <camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle>
            </bpmn:extensionElements>
