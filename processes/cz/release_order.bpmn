            <bpmn:incoming>s41_release_confirmed_guard_no</bpmn:incoming>
            <bpmn:outgoing>s41_release_confirmed_due_task</bpmn:outgoing>
            <bpmn:script>// AU-hartland S4.1 (authored): the confirmation's due date — `def action release_confirmed { due: 2 working_days }`.
// A working day is not a weekend and not a holiday of the world (D-82, contracts §1: date_dim.d_working_day); the
// holidays are the world's public-holiday rules of data/calendar/calendar.sql (world cz), counted on the Prague
// clock from the engine's clock — the one the boundary timer is due on. A process variable ttrApprovalDueOverride
// (an ISO-8601 duration, e.g. PT2M) replaces it: the shortened lapse of a certification walk.
def zone = java.time.ZoneId.of('Europe/Prague')
def now = java.time.ZonedDateTime.ofInstant(org.cibseven.bpm.engine.impl.util.ClockUtil.getCurrentTime().toInstant(), zone)
def fixedDays = ['01-01', '05-01', '05-08', '07-05', '07-06', '09-28', '10-28', '11-17', '12-24', '12-25', '12-26'] as Set
def easterOffsets = [-2, 1]
def easter = { int y -&gt;
    int a = y % 19, b = y.intdiv(100), c = y % 100, d = b.intdiv(4), e = b % 4, f = (b + 8).intdiv(25)
    int g = (b - f + 1).intdiv(3), h = (19 * a + b - d - g + 15) % 30, i = c.intdiv(4), k = c % 4
    int l = (32 + 2 * e + 2 * i - h - k) % 7, m = (a + 11 * h + 22 * l).intdiv(451)
    java.time.LocalDate.of(y, (h + l - 7 * m + 114).intdiv(31), (h + l - 7 * m + 114) % 31 + 1)
}
def workingDay = { java.time.LocalDate day -&gt;
    if (day.getDayOfWeek().getValue() &gt; 5) return false
    if (fixedDays.contains(String.format('%02d-%02d', day.getMonthValue(), day.getDayOfMonth()))) return false
    def e = easter(day.getYear())
    return !easterOffsets.any { day == e.plusDays(it as long) }
}
def override = execution.getVariable('ttrApprovalDueOverride')
def due = now
if (override != null &amp;&amp; override.toString().trim()) {
    due = now.plus(java.time.Duration.parse(override.toString().trim()))
} else {
    int left = 2
    while (left &gt; 0) {
        due = due.plusDays(1)
        if (workingDay(due.toLocalDate())) left--
    }
}
execution.setVariableLocal('ttrApprovalDue', java.util.Date.from(due.toInstant()))
</bpmn:script>
          </bpmn:scriptTask>
          <bpmn:boundaryEvent id="s41_release_confirmed_lapsed" name="Termín uplynul" attachedToRef="n_81796b9e2adbe6e633b9" cancelActivity="true">
            <bpmn:outgoing>s41_release_confirmed_lapsed_perform</bpmn:outgoing>
            <bpmn:timerEventDefinition id="s41_release_confirmed_lapsed_timer">
              <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${ttrApprovalDue}</bpmn:timeDate>
            </bpmn:timerEventDefinition>
          </bpmn:boundaryEvent>
          <bpmn:serviceTask id="s41_release_confirmed_perform" name="Zadržet objednávku pro obchod" camunda:asyncBefore="true">
            <bpmn:extensionElements>
              <camunda:connector>
                <camunda:connectorId>http-connector</camunda:connectorId>
                <camunda:inputOutput>
                  <camunda:inputParameter name="method">POST</camunda:inputParameter>
                  <camunda:inputParameter name="url">${"http://process-engine-egress.process-engine.svc/automation/deployments/release_event_cz/actions/hold/perform"}</camunda:inputParameter>
                  <camunda:inputParameter name="headers">
                    <camunda:map>
                      <camunda:entry key="Content-Type">application/json</camunda:entry>
                    </camunda:map>
                  </camunda:inputParameter>
                  <camunda:inputParameter name="payload">${S('{}').prop("key", S('{}').prop("order", ttrRow.prop("order_number"))).prop("params", S('{}').prop("department", "Sales")).prop("origin", "engine").prop("idempotencyKey", execution.processInstanceId.concat(":lapsed:").concat(ttrRow.prop("order_number").toString())).toString()}</camunda:inputParameter>
                  <camunda:outputParameter name="ttrLapsed">
                    <camunda:script scriptFormat="groovy">def BpmnError; try { BpmnError = Class.forName('org.cibseven.bpm.engine.delegate.BpmnError') } catch (ClassNotFoundException e) { BpmnError = Class.forName('org.camunda.bpm.engine.delegate.BpmnError') }
def code = ((Number) statusCode).intValue()
if (code == 409) throw BpmnError.getConstructor(String, String).newInstance('TTR_STALE', 'perform hold after the lapse: HTTP 409')
if (code &gt;= 400 &amp;&amp; code &lt; 500 &amp;&amp; code != 408 &amp;&amp; code != 429) throw BpmnError.getConstructor(String, String).newInstance('TTR_REFUSED', 'perform hold after the lapse: HTTP ' + code + ': ' + response.toString().take(256))
if (code &lt; 200 || code &gt;= 300) throw new IllegalStateException('perform hold after the lapse: HTTP ' + code)
def SpinClass; try { SpinClass = Class.forName('org.cibseven.spin.Spin') } catch (ClassNotFoundException e) { SpinClass = Class.forName('org.camunda.spin.Spin') }
return SpinClass.JSON(response)
</camunda:script>
                  </camunda:outputParameter>
                  <camunda:outputParameter name="ttrLapsedCode">${statusCode}</camunda:outputParameter>
                </camunda:inputOutput>
              </camunda:connector>
              <camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle>
            </bpmn:extensionElements>
            <bpmn:incoming>s41_release_confirmed_lapsed_perform</bpmn:incoming>
            <bpmn:outgoing>s41_release_confirmed_perform_done</bpmn:outgoing>
          </bpmn:serviceTask>
