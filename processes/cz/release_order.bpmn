      <camunda:executionListener event="start">
        <camunda:script scriptFormat="groovy">// AU-hartland S4.1 (authored): the send tasks' recipients (the skeleton reads TTR_MAIL_RECIPIENTS["role.&lt;r&gt;"]);
// one address per role of the deployment set (processes/sets.json). A caller may pass its own map.
if (execution.getVariable('TTR_MAIL_RECIPIENTS') == null) {
    def variables
    try { variables = Class.forName('org.cibseven.bpm.engine.variable.Variables') }
    catch (ClassNotFoundException e) { variables = Class.forName('org.camunda.bpm.engine.variable.Variables') }
    def recipients = new LinkedHashMap(['role.sales': 'hartland-sales@hartland.example', 'sales': 'hartland-sales@hartland.example', 'role.ar': 'hartland-ar@hartland.example', 'ar': 'hartland-ar@hartland.example', 'role.customer_care': 'hartland-care@hartland.example', 'customer_care': 'hartland-care@hartland.example', 'role.finance': 'hartland-finance@hartland.example', 'finance': 'hartland-finance@hartland.example', 'role.logistics': 'hartland-logistics@hartland.example', 'logistics': 'hartland-logistics@hartland.example', 'customer': 'zakaznik@hartland.example'])
    execution.setVariable('TTR_MAIL_RECIPIENTS',
        variables.objectValue(recipients).serializationDataFormat('application/json').create())
}
</camunda:script>
