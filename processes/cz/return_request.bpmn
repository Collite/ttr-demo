      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:serviceTask id="s41_settle_verdict" name="Výsledek vyrovnání" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">${"http://process-engine-egress.process-engine.svc/automation/runs/".concat(ttrAnchor)}</camunda:inputParameter>
            <camunda:outputParameter name="ttrVerdict">
              <camunda:script scriptFormat="groovy">def BpmnError; try { BpmnError = Class.forName('org.cibseven.bpm.engine.delegate.BpmnError') } catch (ClassNotFoundException e) { BpmnError = Class.forName('org.camunda.bpm.engine.delegate.BpmnError') }
def code = ((Number) statusCode).intValue()
if (code == 409) throw BpmnError.getConstructor(String, String).newInstance('TTR_STALE', 'the settle verdict: HTTP 409')
if (code &gt;= 400 &amp;&amp; code &lt; 500 &amp;&amp; code != 408 &amp;&amp; code != 429) throw BpmnError.getConstructor(String, String).newInstance('TTR_REFUSED', 'the settle verdict: HTTP ' + code + ': ' + response.toString().take(256))
if (code &lt; 200 || code &gt;= 300) throw new IllegalStateException('the settle verdict: HTTP ' + code)
def SpinClass; try { SpinClass = Class.forName('org.cibseven.spin.Spin') } catch (ClassNotFoundException e) { SpinClass = Class.forName('org.camunda.spin.Spin') }
return SpinClass.JSON(response)
</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
        <camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>s41_f_settle_run_verdict</bpmn:incoming>
      <bpmn:outgoing>s41_f_settle_verdict_route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s41_settle_route" name="Vyrovnáno?" default="s41_f_settle_again">
      <bpmn:incoming>s41_f_settle_verdict_route</bpmn:incoming>
      <bpmn:outgoing>s41_f_settle_again</bpmn:outgoing>
      <bpmn:outgoing>s41_f_settle_closed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="s41_not_returned" name="zboží nevráceno">
      <bpmn:incoming>s41_f_inbound_expired</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="s41_closed" name="uzavřeno">
      <bpmn:incoming>s41_f_settle_closed</bpmn:incoming>
    </bpmn:endEvent>
