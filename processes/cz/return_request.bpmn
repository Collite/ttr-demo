        <bpmn:sequenceFlow id="n_2e47bdd6edf744c9438a" name="ask to_customer_care" sourceRef="n_b90eba1240285a57fc4f" targetRef="n_9c2c2ce0192021c8441a">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ttrEvaluation.prop("verdict").prop("routes").prop("to_customer_care").prop('rowCount').numberValue() &gt; 0}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="n_6947bca7f83c5ebc19f7" sourceRef="n_9c2c2ce0192021c8441a" targetRef="n_a775980feb612d43bed5" />
        <bpmn:sequenceFlow id="n_fdc6014d46cdf251fb35" sourceRef="n_8cbd331c72195d1fc5ed" targetRef="n_c97754c5baed77df6f1e" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="n_5de8aa87f95c927864c7" sourceRef="n_3bf99ff7d480c9b685fd" targetRef="n_3665049028896d29b543" />
      <bpmn:sequenceFlow id="n_084c91bebca3ae467e05" sourceRef="n_3665049028896d29b543" targetRef="n_ab637ac7a6bacc5b55e6" />
      <bpmn:sequenceFlow id="n_5c92a2c3755516d7cd66" name="200 replayed" sourceRef="n_ab637ac7a6bacc5b55e6" targetRef="n_6a24cb2613e18a59642e">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${(ttrOpenCode == 200) &amp;&amp; (ttrOpen.prop("replayed").boolValue())}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="n_4168ce9235fe5caf560d" name="201 claimed" sourceRef="n_ab637ac7a6bacc5b55e6" targetRef="n_7114175aacf059d57d98">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ttrOpenCode == 201}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="n_fe9ae66f74b2a395d69c" name="202 handle" sourceRef="n_ab637ac7a6bacc5b55e6" targetRef="n_8c268879c65f20c916ba">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ttrOpenCode == 202}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="n_502a68295d31c6d978b4" sourceRef="n_ab637ac7a6bacc5b55e6" targetRef="n_033158fb276e325f4f71" />
      <bpmn:sequenceFlow id="n_b3898654f45df5515426" sourceRef="n_4821ee2849a949a07359" targetRef="n_033158fb276e325f4f71" />
      <bpmn:sequenceFlow id="n_859ab79dc71baffdcfbf" sourceRef="n_8c268879c65f20c916ba" targetRef="n_95548ce4141cb58add9c" />
      <bpmn:sequenceFlow id="n_2f0de5cfd3b78795a40f" name="closed or waiting" sourceRef="n_95548ce4141cb58add9c" targetRef="n_6a24cb2613e18a59642e">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${(ttrHandle.prop("status").stringValue() == "closed") || (ttrHandle.prop("status").stringValue() == "waiting")}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="n_0f91e23278e489538530" name="abandoned or failed" sourceRef="n_95548ce4141cb58add9c" targetRef="n_2d99a7a92f3bcc129bbb">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${(ttrHandle.prop("status").stringValue() == "abandoned") || (ttrHandle.prop("status").stringValue() == "failed")}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="n_6b3cb8e6d309d6839f3f" sourceRef="n_95548ce4141cb58add9c" targetRef="n_033158fb276e325f4f71" />
      <bpmn:sequenceFlow id="n_fa25c423d6780174865e" sourceRef="n_2d99a7a92f3bcc129bbb" targetRef="n_b496183e7be9a881f901" />
      <bpmn:sequenceFlow id="n_48a554cca28ba94c20e9" name="201 recovered" sourceRef="n_b496183e7be9a881f901" targetRef="n_7114175aacf059d57d98">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ttrOpenCode == 201}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="n_75d0a01119617e7f20a0" sourceRef="n_b496183e7be9a881f901" targetRef="n_033158fb276e325f4f71" />
      <bpmn:sequenceFlow id="n_bfbfecd29fa7fec7923e" sourceRef="n_7114175aacf059d57d98" targetRef="n_99c76cb2d16b9e7ca9e3" />
      <bpmn:sequenceFlow id="n_eef923b83ea4706f2db5" sourceRef="n_99c76cb2d16b9e7ca9e3" targetRef="n_6a24cb2613e18a59642e" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="n_0fc13eb098df4b6dfd78" name="decide_on_request_cz step complete">
      <bpmn:incoming>n_7038fa4e0ed8290bfc62</bpmn:incoming>
      <bpmn:outgoing>n_12b7fb815e7d36299bc9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent attachedToRef="n_d0fe82de29ffec851d18" cancelActivity="true" id="n_9ebe3ee5db1025649895" name="decide_on_request_cz stale export">
      <bpmn:outgoing>n_d8d165892796b2148a52</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="stale_export" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent attachedToRef="n_d0fe82de29ffec851d18" cancelActivity="true" id="n_001184d95ca9fff54fc6" name="decide_on_request_cz run refused">
      <bpmn:outgoing>n_f58e57a2d070e43bb44f</bpmn:outgoing>
      <bpmn:errorEventDefinition camunda:errorMessageVariable="ttrRefusedReason" errorRef="run_refused" />
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="s41_decide_run" name="Výsledek rozhodnutí" scriptFormat="groovy">
      <bpmn:incoming>n_12b7fb815e7d36299bc9</bpmn:incoming>
      <bpmn:outgoing>s41_f_remember</bpmn:outgoing>
      <bpmn:script>execution.setVariable('ttrDecideRun', execution.getVariable('ttrAnchor'))</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="s41_decide_verdict" name="Výsledek rozhodnutí" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">${"http://process-engine-egress.process-engine.svc/automation/runs/".concat(ttrDecideRun)}</camunda:inputParameter>
            <camunda:outputParameter name="ttrVerdict">
              <camunda:script scriptFormat="groovy">def BpmnError; try { BpmnError = Class.forName('org.cibseven.bpm.engine.delegate.BpmnError') } catch (ClassNotFoundException e) { BpmnError = Class.forName('org.camunda.bpm.engine.delegate.BpmnError') }
def code = ((Number) statusCode).intValue()
if (code == 409) throw BpmnError.getConstructor(String, String).newInstance('TTR_STALE', 'the decision\'s status: HTTP 409')
if (code &gt;= 400 &amp;&amp; code &lt; 500 &amp;&amp; code != 408 &amp;&amp; code != 429) throw BpmnError.getConstructor(String, String).newInstance('TTR_REFUSED', 'the decision\'s status: HTTP ' + code + ': ' + response.toString().take(256))
if (code &lt; 200 || code &gt;= 300) throw new IllegalStateException('the decision\'s status: HTTP ' + code)
def SpinClass; try { SpinClass = Class.forName('org.cibseven.spin.Spin') } catch (ClassNotFoundException e) { SpinClass = Class.forName('org.camunda.spin.Spin') }
return SpinClass.JSON(response)
</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
        <camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>s41_f_remember</bpmn:incoming>
      <bpmn:outgoing>s41_f_verdict_way</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s41_way" name="Způsob?" default="s41_f_way_rejected">
      <bpmn:incoming>s41_f_verdict_way</bpmn:incoming>
      <bpmn:outgoing>s41_f_way_rejected</bpmn:outgoing>
      <bpmn:outgoing>s41_f_way_care</bpmn:outgoing>
      <bpmn:outgoing>s41_f_way_exchange</bpmn:outgoing>
      <bpmn:outgoing>s41_f_way_refund_after_return</bpmn:outgoing>
      <bpmn:outgoing>s41_f_way_refund_no_return</bpmn:outgoing>
      <bpmn:outgoing>s41_f_way_replacement_no_return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="s41_rejected" name="zamítnuto">
      <bpmn:incoming>s41_f_way_rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s41_care_row" name="Řádek pro péči" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">${"http://process-engine-egress.process-engine.svc/automation/runs/".concat(ttrDecideRun).concat("/routes/to_customer_care")}</camunda:inputParameter>
            <camunda:outputParameter name="ttrCareRows">
              <camunda:script scriptFormat="groovy">def BpmnError; try { BpmnError = Class.forName('org.cibseven.bpm.engine.delegate.BpmnError') } catch (ClassNotFoundException e) { BpmnError = Class.forName('org.camunda.bpm.engine.delegate.BpmnError') }
def code = ((Number) statusCode).intValue()
if (code == 409) throw BpmnError.getConstructor(String, String).newInstance('TTR_STALE', 'the care route\'s row: HTTP 409')
if (code &gt;= 400 &amp;&amp; code &lt; 500 &amp;&amp; code != 408 &amp;&amp; code != 429) throw BpmnError.getConstructor(String, String).newInstance('TTR_REFUSED', 'the care route\'s row: HTTP ' + code + ': ' + response.toString().take(256))
if (code &lt; 200 || code &gt;= 300) throw new IllegalStateException('the care route\'s row: HTTP ' + code)
def SpinClass; try { SpinClass = Class.forName('org.cibseven.spin.Spin') } catch (ClassNotFoundException e) { SpinClass = Class.forName('org.camunda.spin.Spin') }
return SpinClass.JSON(response)
</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
        <camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>s41_f_way_care</bpmn:incoming>
      <bpmn:outgoing>s41_f_care_row_due</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="s41_care" name="Rozhodněte o způsobu vyřízení řádku ${ttrInput['key']['line_id']}" camunda:candidateGroups="hartland-care" camunda:dueDate="${ttrApprovalDue}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="way" label="Způsob vyřízení" type="enum">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
            <camunda:value id="refund_no_return" name="Vrácení peněz bez vrácení zboží" />
            <camunda:value id="replacement_no_return" name="Náhrada bez vrácení zboží" />
            <camunda:value id="exchange" name="Výměna zboží" />
            <camunda:value id="refund_after_return" name="Vrácení peněz po vrácení zboží" />
          </camunda:formField>
        </camunda:formData>
        <camunda:inputOutput>
          <camunda:inputParameter name="ttrAction">${"decide_way"}</camunda:inputParameter>
          <camunda:inputParameter name="ttrKey">${ttrInput['key']['line_id']}</camunda:inputParameter>
          <camunda:outputParameter name="way">${way}</camunda:outputParameter>
          <camunda:outputParameter name="ttrCareBy">${ttrCareBy}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:taskListener event="create">
          <camunda:script scriptFormat="groovy">// AU-hartland S4.1 (authored): what Hebe and the D-98 guard read from the task itself (HE-8): the action and its key.
task.setVariableLocal('ttr_action', 'decide_way')
task.setVariableLocal('ttr_about', String.valueOf(task.getVariable('ttrKey')))
</camunda:script>
        </camunda:taskListener>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="groovy">// AU-hartland S4.1 (authored): who decided (D-168's `by`), as the engine saw the completion.
task.execution.setVariable('ttrCareBy', task.getAssignee())
</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>s41_f_care_due_task</bpmn:incoming>
      <bpmn:outgoing>s41_f_care_perform</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="s41_care_due" name="Termín potvrzení" scriptFormat="groovy">
      <bpmn:incoming>s41_f_care_row_due</bpmn:incoming>
      <bpmn:outgoing>s41_f_care_due_task</bpmn:outgoing>
      <bpmn:script>// AU-hartland S4.1 (authored): the confirmation's due date — `def action decide_way { due: 3 working_days }`,
// Monday to Friday on the Prague clock (the world calendar's holidays are not read here). A process variable
// ttrApprovalDueOverride (an ISO-8601 duration, e.g. PT2M) replaces it: the shortened lapse of a certification walk.
def zone = java.time.ZoneId.of('Europe/Prague')
def now = java.time.ZonedDateTime.now(zone)
def override = execution.getVariable('ttrApprovalDueOverride')
def due = now
if (override != null &amp;&amp; override.toString().trim()) {
    due = now.plus(java.time.Duration.parse(override.toString().trim()))
} else {
    int left = 3
    while (left &gt; 0) {
        due = due.plusDays(1)
        if (due.getDayOfWeek().getValue() &lt; 6) left--
    }
}
execution.setVariableLocal('ttrApprovalDue', java.util.Date.from(due.toInstant()))
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="s41_care_perform" name="Provést rozhodnutí péče" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">${"http://process-engine-egress.process-engine.svc/automation/deployments/decide_event_cz/actions/decide_way/perform"}</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">${S('{}').prop("key", S('{}').prop("line", ttrCareRows.prop("rows").elements().get(0).prop("line_id"))).prop("params", S('{}').prop("to", (way == 'exchange' || way == 'refund_after_return' ? 'awaiting_goods' : 'settling')).prop("way", way)).prop("by", ttrCareBy).prop("origin", "engine").prop("idempotencyKey", execution.processInstanceId.concat(":care")).toString()}</camunda:inputParameter>
            <camunda:outputParameter name="ttrCarePerformed">
              <camunda:script scriptFormat="groovy">def BpmnError; try { BpmnError = Class.forName('org.cibseven.bpm.engine.delegate.BpmnError') } catch (ClassNotFoundException e) { BpmnError = Class.forName('org.camunda.bpm.engine.delegate.BpmnError') }
def code = ((Number) statusCode).intValue()
if (code == 409) throw BpmnError.getConstructor(String, String).newInstance('TTR_STALE', 'perform decide_way: HTTP 409')
if (code &gt;= 400 &amp;&amp; code &lt; 500 &amp;&amp; code != 408 &amp;&amp; code != 429) throw BpmnError.getConstructor(String, String).newInstance('TTR_REFUSED', 'perform decide_way: HTTP ' + code + ': ' + response.toString().take(256))
if (code &lt; 200 || code &gt;= 300) throw new IllegalStateException('perform decide_way: HTTP ' + code)
def SpinClass; try { SpinClass = Class.forName('org.cibseven.spin.Spin') } catch (ClassNotFoundException e) { SpinClass = Class.forName('org.camunda.spin.Spin') }
return SpinClass.JSON(response)
</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
        <camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>s41_f_care_perform</bpmn:incoming>
      <bpmn:outgoing>s41_f_care_performed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s41_care_way" name="Zvolený způsob?" default="s41_f_care_settle">
      <bpmn:incoming>s41_f_care_performed</bpmn:incoming>
      <bpmn:outgoing>s41_f_care_inbound</bpmn:outgoing>
      <bpmn:outgoing>s41_f_care_settle</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="s41_instructions" name="Pokyny k vrácení zákazníkovi" camunda:type="external" camunda:topic="TTR_CONN_MAIL">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="ttrRecipient">${ttrCareRows.prop("rows").elements().get(0).prop("customer_email").stringValue()}</camunda:inputParameter>
          <camunda:inputParameter name="ttrRow">${ttrCareRows.prop("rows").elements().get(0)}</camunda:inputParameter>
          <camunda:inputParameter name="ttrAction">${"notify_customer"}</camunda:inputParameter>
          <camunda:inputParameter name="ttrTemplate">${"return-instructions"}</camunda:inputParameter>
          <camunda:inputParameter name="ttrKey">${ttrInput['key']['line_id']}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>s41_f_care_inbound</bpmn:incoming>
      <bpmn:outgoing>s41_f_instructions_inbound</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="s41_inbound_again" name="Čekat na příjem zboží">
      <bpmn:incoming>s41_f_inbound_again</bpmn:incoming>
      <bpmn:incoming>s41_f_way_exchange</bpmn:incoming>
      <bpmn:incoming>s41_f_way_refund_after_return</bpmn:incoming>
      <bpmn:incoming>s41_f_instructions_inbound</bpmn:incoming>
      <bpmn:outgoing>s41_f_inbound_merge_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="s41_inbound_wait" name="Čekat na příjem zboží">
      <bpmn:incoming>s41_f_inbound_merge_wait</bpmn:incoming>
      <bpmn:outgoing>s41_f_inbound_wait_message</bpmn:outgoing>
      <bpmn:outgoing>s41_f_inbound_wait_timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="s41_inbound_message" name="příjemka zaúčtována">
      <bpmn:incoming>s41_f_inbound_wait_message</bpmn:incoming>
      <bpmn:outgoing>s41_f_inbound_message_round</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s41_inbound_message_def" messageRef="s41_message_receipt_posted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="s41_inbound_timer" name="denně">
      <bpmn:incoming>s41_f_inbound_wait_timer</bpmn:incoming>
      <bpmn:outgoing>s41_f_inbound_timer_round</bpmn:outgoing>
      <bpmn:timerEventDefinition id="s41_inbound_timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${execution.getVariable('ttrLoopPeriod') != null ? ttrLoopPeriod : 'P1D'}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="s41_inbound_round" name="Kolo kontroly příjmu" scriptFormat="groovy">
      <bpmn:incoming>s41_f_inbound_message_round</bpmn:incoming>
      <bpmn:incoming>s41_f_inbound_timer_round</bpmn:incoming>
      <bpmn:outgoing>s41_f_inbound_round_run</bpmn:outgoing>
      <bpmn:script>// AU-hartland S4.1 (authored): this round's port {{key, at}} — the line's key from the message that started the
// instance, and the round's clock: the `at` of the message that woke it (the driver sends the timeline's time), else
// now on the Prague clock. A fresh `at` per round: on-event runs deduplicate on it, so a reused one would replay.
def variables
try {{ variables = Class.forName('org.cibseven.bpm.engine.variable.Variables') }}
catch (ClassNotFoundException e) {{ variables = Class.forName('org.camunda.bpm.engine.variable.Variables') }}
def first = execution.getVariable('ttrInput')
def at = execution.getVariable('ttrEventAt')
if (at == null || !at.toString().trim()) at = java.time.OffsetDateTime.now(java.time.ZoneId.of('Europe/Prague')).toString()
execution.removeVariable('ttrEventAt')
def round = new LinkedHashMap([key: first['key'], at: at.toString()])
execution.setVariable('ttrInput', variables.objectValue(round).serializationDataFormat('application/json').create())
</bpmn:script>
    </bpmn:scriptTask>
