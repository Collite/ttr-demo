                  <camunda:outputParameter name="ttrClosedHeaders">${headers}</camunda:outputParameter>
                  <camunda:outputParameter name="ttrClosedRetryAfter">
                    <camunda:script scriptFormat="groovy">def value = headers['retry-after'] ?: headers['Retry-After']
try {
