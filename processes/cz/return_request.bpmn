              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ttrPage.prop('rows').elements().size() == ttrPageState.prop('size').numberValue() &amp;&amp; ttrPageState.prop('offset').numberValue() &lt; ttrExpectedRows &amp;&amp; ttrPageState.prop('reads').numberValue() * ttrPageState.prop('size').numberValue() &lt; ttrExpectedRows}</bpmn:conditionExpression>
