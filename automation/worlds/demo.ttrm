package hartland.worlds
model world

// AU (automation agents) — the hartland demo world: where the recipes of `automation/` read and write, who may run
// them, and as whom. contracts.md §3 (project/kantheon/features/automation-agents/implementation/hartland/); the
// qname `hartland.worlds.demo` is what a recipe names in `uses world "hartland.worlds.demo"` (17 §3).
//
// ONE WORLD FILE, TWO WORLDS BY CONNECTION. Hartland is one model over two databases (US `hartland_us`,
// CZ `hartland_cz`), and the world follows: nothing here names a world's database. A bundle reads its
// credentials from `TTR_CONN_<ENGINE>` (ttr-p contracts §5; the engine name upper-cased), so
//   TTR_CONN_ERP        → `hartland_us` or `hartland_cz`,
//   TTR_CONN_AUTOMATION → the `automation` database, search_path `us` or `cz` (⚑AU-P-2 = D-118),
// and the deployment that sets them picks the world. The CZ recipes differ from the US ones only in prose.
// The service principal's credential is a different variable, TTR_CONN_AUTOMATION_DECIDER (D-132).
//
// Written in ttr-core grammar 0.22 (AU-hartland P3E): the automation members nest in `def world demo` (R1), executor
// types are ids (`extends: process_engine`, `n8n_l1` — R3). The automation half is AU design `20` §2, as the
// toolchain's engine fixture spells it (ttr-core `ttrp-frontend/src/test/resources/recipes/hartland-engine/`), with
// bp-dsk's real engine URLs. Not written, because 0.16 has no property for them and nothing reads
// them: `schemas: [dbo]` (the model's `[schemas.dbo]` handle in modeler.toml names the ERP schema) and `rls: true`
// (the ERP's row-level rules are LR G2's, enforced at the door).
//
// WHY THIS FILE IS IN `automation/`, not `model/` (where AU-hartland P0 put it): its members name the programs and
// roles of `automation/*.ttrm` and the toolchain's automation entities (`obligation`, …), and a reader of `model/`
// alone — veles, the lexicon build — would report every one of them unresolved (the lexicon build refuses to load
// such a model). The automation service loads `model/` + `automation/` as one project (ttr-server contracts §1.1),
// so the world resolves there, beside the package it serves (contracts §4's layout).

def world demo {
    description: "Hartland demo world — the ERP (the hartland warehouse, one per world) and the automation ledger."

    def engine erp        { type: postgres }
    def engine automation { type: postgres }

    // The writer's targets (D-79): the ERP columns and tables the recipes' actions may write.
    def storage erp_db {
        type: postgres, via: erp, hosts: [hartland],
        writable: [order.state, order.held_for, return_request_line.state, return_request_line.way, reorder_proposal, winback_mail]
    }

    // The ledger's (D-76): the toolchain's automation entities and every recipe's generated verdict tables,
    // `_current` included — the writer keeps it itself, a key-scoped delete + insert per batch (D-105, R217-D).
    def storage automation_db {
        type: postgres, via: automation,
        writable: [obligation, state_history, "*_verdict", "*_verdict_detail", "*_verdict_current", approvals]
    }

    // Island outputs of a run land here as Arrow IPC, `runs/{id}/{island}.{port}.arrow` (10 B-6); the
    // automation service roots the directory and releases it at close + grace (D-73).
    def storage stage { type: local_dir, staging: true }

    // ---- the automation half — AU design `20` §2 (D-107; re-typed for the engine at P3E, grammar 0.22) ----
    // One program on one target under one identity per deployment (D-90, D-158). Flow, timers, waits and human tasks
    // are BPMN (`20` rules 2–5): no `def process`, no `trigger:`, no `target: native`. The six native debug
    // deployments went too (D-167).
    def identity automation_decider { principal: "svc-hartland-automation", credential: TTR_CONN_AUTOMATION_DECIDER }   // no policy narrows it; D-132
    def identity process_engine     { principal: "process-engine",          credential: TTR_CONN_PROCESS_ENGINE }       // the engine's own client (D-150)
    def identity maya               { principal: "persona-maya",            credential: TTR_CONN_PERSONA_MAYA }         // F1d persona (D-158)

    // bp-dsk's engine (olymp clusters/bp-dsk/apps/process-engine): REST in-cluster, and the egress proxy its HTTP
    // connector calls the automation service through (D-145, D-158).
    def executor engine { extends: process_engine, url: "http://process-engine.process-engine.svc/engine-rest",
                          egress_url: "http://process-engine-egress.process-engine.svc/automation", connection: engine_bp_dsk }
    def executor n8n    { extends: n8n_l1,   url: "https://n8n.hartland.example",  connection: n8n_hartland }
    def executor py     { extends: python_client }
    // removed: def executor bpmn { extends: camunda_8 } (file only) — the engine target deploys (D-145)

    def grant { who: identity.process_engine, program: *,                    as: identity.automation_decider }   // F1a (D-158)
    def grant { who: role.ops,                program: *,                    as: identity.automation_decider }
    def grant { who: role.sales_manager,      program: release_on_placement, as: identity.maya }                  // "release 4711" from Hebe runs as Maya's persona (⚑20-4)
    def grant { who: role.process_owner,      program: *,                    as: identity.automation_decider }   // debug runs "as the recipe runs" (D-93)

    // H-1 — one program per deployment; the timer / message start lives in the BPMN
    def deployment release_morning  { program: morning_release,      target: engine, run_as: identity.automation_decider }
    def deployment release_event    { program: release_on_placement, target: engine, run_as: identity.automation_decider, startable_by: role.sales_manager }
    def deployment release_n8n      { program: release_on_placement, target: n8n,    run_as: identity.automation_decider, granularity: parts }
    def deployment release_py       { program: release_on_placement, target: py,     run_as: identity.automation_decider }

    // H-2 — three on_event deployments the authored `returns.bpmn` calls, three batch deployments the catch-up timer calls
    def deployment decide_event     { program: decide_on_request,  target: engine, run_as: identity.automation_decider }
    def deployment inbound_event    { program: inbound_on_receipt, target: engine, run_as: identity.automation_decider }
    def deployment settle_event     { program: settle_on_document, target: engine, run_as: identity.automation_decider }
    def deployment decide_batch     { program: decide_catch_up,    target: engine, run_as: identity.automation_decider }
    def deployment inbound_batch    { program: inbound_daily,      target: engine, run_as: identity.automation_decider }
    def deployment settle_batch     { program: settle_daily,       target: engine, run_as: identity.automation_decider }
    // removed: def process return_line_flow + deployment returns_n8n — the flow is hartland/processes/returns.bpmn (`20` rule 5)

    // Ops deployments resume in Server P4 when automation.ops is served. The authoring stubs
    // stay out of the served model; no_run_since also needs row-dependent time arithmetic.
}
