// hartland's programs — AU design `20` §1 (D-26, D-104; re-typed for the engine at AU-hartland P3E, grammar 0.22).
// A program keeps its recipe, `port`, `mode` and `as_of`; who calls it and when is the BPMN's start event (a timer,
// a message, Hebe), so `deliver`, `schedule`, `port: event`/`event:` and the event schemas are gone (D-142, D-143).
// The eight programs of `20` §1, plus hartland's: the CZ money twins (D-155), one batch program each for H-3 and H-5,
// and the two hourly ops programs (D-72: alert rules are recipes; D-80: `protocol: on_route` writes the protocol only
// for a routed run). Spellings are the toolchain's (`on_event`, `on_route`).
package hartland.automation
model automation

// ---- programs (binding; D-26): mode and port only (`20` rule 4) ----
def program morning_release        { recipe: release_order,  port: none,  mode: batch,    as_of: run }
def program release_on_placement   { recipe: release_order,  port: key,   mode: on_event, as_of: event }

def program decide_on_request      { recipe: decide_return,  port: key,   mode: on_event, as_of: event }
def program decide_catch_up        { recipe: decide_return,  port: none,  mode: batch,    as_of: run }

// CZ money parameters (×25) — until overrides live on the deployment (D-26 amendment, Core backlog)
def program morning_release_cz            { recipe: release_order,  port: none,  mode: batch,    as_of: run,   overrides: { confirmation_threshold: 1250000 } }
def program release_on_placement_cz       { recipe: release_order,  port: key,   mode: on_event, as_of: event, overrides: { confirmation_threshold: 1250000 } }
def program decide_on_request_cz          { recipe: decide_return,  port: key,   mode: on_event, as_of: event, overrides: { small_value: 375, care_threshold: 12500 } }
def program decide_catch_up_cz            { recipe: decide_return,  port: none,  mode: batch,    as_of: run,   overrides: { small_value: 375, care_threshold: 12500 } }

def program inbound_on_receipt     { recipe: monitor_inbound, port: key,  mode: on_event, as_of: event }
def program inbound_daily          { recipe: monitor_inbound, port: none, mode: batch,    as_of: run }
def program settle_on_document     { recipe: settle,          port: key,  mode: on_event, as_of: event }
def program settle_daily           { recipe: settle,          port: none, mode: batch,    as_of: run }

// H-3 and H-5 (04): the whole candidate set (weekly and monthly, by the BPMN's timer).
def program reorder_weekly         { recipe: reorder_proposals, port: none, mode: batch, as_of: run }
def program winback_monthly        { recipe: winback,           port: none, mode: batch, as_of: run }

// The ops recipes (D-72, D-80): hourly by the BPMN's timer, the protocol only when a route fired.
def program no_run_since_hourly          { recipe: no_run_since,          port: none, mode: batch, as_of: run, protocol: on_route }
def program obligation_due_passed_hourly { recipe: obligation_due_passed, port: none, mode: batch, as_of: run, protocol: on_route }
// removed: def schema line_received / receipt_posted / settlement_posted — the ERP's events are engine messages (D-143)
