// hartland's programs and event schemas — AU design `17` §1 (binding; D-26, D-104), written for ttr-core grammar
// 0.16 (`model automation`; `on_event` for `on-event`, `on_route` for `on-route` — R5). The eight programs of `17`
// are the toolchain's fixture (ttr-core `packages/kotlin/ttr-parser/src/test/resources/automation/programs.ttrm`)
// verbatim. Added here (AU-hartland P2 · S2.2): one batch program each for H-3 and H-5, and the two hourly ops
// programs (D-72: alert rules are recipes; D-80: `protocol: on_route` writes the protocol only for a routed run).
// `schedule:` strings are exporter hints (D-106): the Server's trigger is the deployment's, in the world.
package hartland.automation
model automation

// ---- programs (binding; D-26) ----
def program morning_release        { recipe: release_order,  port: none,  mode: batch,    as_of: run,   deliver: { digest: { by: who, per: day } }, schedule: "06:00 Europe/Prague" }
def program release_on_placement   { recipe: release_order,  port: key,   mode: on_event, as_of: event, deliver: immediate }

def program decide_on_request      { recipe: decide_return,  port: event, event: schema.line_received,  mode: on_event, as_of: event }
def program decide_catch_up        { recipe: decide_return,  port: none,  mode: batch,    as_of: run,   schedule: "06:30 Europe/Prague" }
def program inbound_on_receipt     { recipe: monitor_inbound, port: event, event: schema.receipt_posted, mode: on_event, as_of: event }
def program inbound_daily          { recipe: monitor_inbound, port: none, mode: batch,    as_of: run,   schedule: "07:00 Europe/Prague" }
def program settle_on_document     { recipe: settle,          port: event, event: schema.settlement_posted, mode: on_event, as_of: event }
def program settle_daily           { recipe: settle,          port: none, mode: batch,    as_of: run,   schedule: "07:30 Europe/Prague" }

// H-3 and H-5 (04): the whole candidate set, once a week and once a month — previews and debug runs at P3 (no
// deployment yet).
def program reorder_weekly         { recipe: reorder_proposals, port: none, mode: batch, as_of: run, schedule: "Mon 05:30 Europe/Prague" }
def program winback_monthly        { recipe: winback,           port: none, mode: batch, as_of: run, schedule: "1st 08:00 Europe/Prague" }

// The ops recipes (D-72, D-80): hourly, the protocol only when a route fired.
def program no_run_since_hourly          { recipe: no_run_since,          port: none, mode: batch, as_of: run, protocol: on_route, schedule: "*/60" }
def program obligation_due_passed_hourly { recipe: obligation_due_passed, port: none, mode: batch, as_of: run, protocol: on_route, schedule: "*/60" }

def schema line_received    { columns: [def column line_id { type: return_request_line.line_id }] }   // the generator posts one event per line
def schema receipt_posted   { columns: [def column line_id { type: return_request_line.line_id }] }
def schema settlement_posted{ columns: [def column line_id { type: return_request_line.line_id }] }
