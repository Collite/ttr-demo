    "Český přehled": {
      "main": [
        [
          {
            "node": "Odeslat do Mailpitu",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "timezone": "Europe/Prague"
  },
  "active": true,
  "meta": {
    "ttrDemo": {
