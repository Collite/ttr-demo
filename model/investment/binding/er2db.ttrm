package investment

model binding

// er2db — the whole binding, in ONE file (IE-C24). The manual recommends it and there is a second
// reason: this is the file a reviewer has to read to know that the interpreted face and the estate
// agree, and a binding spread over six files is a binding nobody reads.
//
// ⛔ NOTHING IN THE TOOLCHAIN CHECKS A `target:`. IE-P0 V8b measured it: through the full parse +
// resolve + lintProject pipeline, `target: { table: db.dbo.no_such_table }` lints CLEAN, while a
// bogus `entity:` ref does raise `ttr/unresolved-reference`. So a typo in a physical name here is
// invisible until Veles plans a query on the estate. `binding.test.mjs` T2.3 walks every target
// against the `db` layer, and `db-ddl-parity.test.mjs` walks the `db` layer against the real DDL;
// those two together are the only thing between a typo and a live failure.
//
// ⛔ AND THERE IS NO `whereFilter` ANYWHERE BELOW, ON PURPOSE (IE-C24 / IE-P0 V9).
// `whereFilter: { valid_to: null }` PARSES — which is exactly what made it look available — and is
// then dropped: `ttr-metadata`'s `Er2DbEntityMapping` has no such field and veles's
// `toEr2DbEntityMappingDetail` leaves the proto's `where_filter` unset, so translate's
// `SnapshotModelHandle`, the one thing that would consume it, always sees null. Writing one would
// be a rule the model CLAIMS and does not enforce, which is worse than not writing it: `client`,
// `portfolio` and `position` are bound unfiltered here and every query over them carries
// `valid_to IS NULL` in its own text (IE-C25).
//
// Only RENAMED attributes are mapped below. An attribute whose name already equals its column is
// synthesized by name, and declaring it too would be a duplicate mapping. Every rename is a place
// where the book's vocabulary and Midas's diverge deliberately — `binding.test.mjs` T2.6 checks
// that everything else has a same-named column to be synthesized from, so silence is never a gap.

// ===== client → investment_client =====
def er2db_entity client_map { entity: er.entity.client, target: { table: db.dbo.investment_client } }
def er2db_attribute client_client_id_map     { attribute: er.entity.client.client_id,     target: { column: db.dbo.investment_client.external_id } }
def er2db_attribute client_contact_email_map { attribute: er.entity.client.contact_email, target: { column: db.dbo.investment_client.email } }
def er2db_attribute client_since_map         { attribute: er.entity.client.since,         target: { column: db.dbo.investment_client.valid_from } }

// ===== portfolio → investment_portfolio =====
def er2db_entity portfolio_map { entity: er.entity.portfolio, target: { table: db.dbo.investment_portfolio } }
def er2db_attribute portfolio_portfolio_id_map { attribute: er.entity.portfolio.portfolio_id, target: { column: db.dbo.investment_portfolio.external_id } }
def er2db_attribute portfolio_client_map       { attribute: er.entity.portfolio.client,       target: { column: db.dbo.investment_portfolio.client_ref } }
def er2db_attribute portfolio_name_map         { attribute: er.entity.portfolio.name,         target: { column: db.dbo.investment_portfolio.label } }
def er2db_attribute portfolio_since_map        { attribute: er.entity.portfolio.since,        target: { column: db.dbo.investment_portfolio.valid_from } }

// ===== asset → investment_asset =====
def er2db_entity asset_map { entity: er.entity.asset, target: { table: db.dbo.investment_asset } }
def er2db_attribute asset_asset_id_map { attribute: er.entity.asset.asset_id, target: { column: db.dbo.investment_asset.isin } }
def er2db_attribute asset_kind_map     { attribute: er.entity.asset.kind,     target: { column: db.dbo.investment_asset.asset_class } }

// ===== price → investment_asset_price =====
// The one entity whose er name and table name differ on purpose: `price` is what a person says,
// `investment_asset_price` is what the estate calls the table.
def er2db_entity price_map { entity: er.entity.price, target: { table: db.dbo.investment_asset_price } }
def er2db_attribute price_asset_map { attribute: er.entity.price.asset, target: { column: db.dbo.investment_asset_price.isin } }

// ===== transaction → investment_transaction =====
def er2db_entity transaction_map { entity: er.entity.transaction, target: { table: db.dbo.investment_transaction } }
def er2db_attribute transaction_transaction_id_map { attribute: er.entity.transaction.transaction_id, target: { column: db.dbo.investment_transaction.sk } }
def er2db_attribute transaction_portfolio_map      { attribute: er.entity.transaction.portfolio,      target: { column: db.dbo.investment_transaction.portfolio_ref } }
def er2db_attribute transaction_asset_map          { attribute: er.entity.transaction.asset,          target: { column: db.dbo.investment_transaction.asset_ref } }

// ===== position → investment_position =====
def er2db_entity position_map { entity: er.entity.position, target: { table: db.dbo.investment_position } }
def er2db_attribute position_portfolio_map { attribute: er.entity.position.portfolio, target: { column: db.dbo.investment_position.portfolio_ref } }
def er2db_attribute position_asset_map     { attribute: er.entity.position.asset,     target: { column: db.dbo.investment_position.asset_ref } }

// ===== the rate model (IA-P3b·S3b.1, IA-C65–C67) =====
// `exchange_rate` is the er name for `investment_fx_rate` — the second entity whose er and table names
// differ on purpose (after `price`): a person asks for an exchange rate; the estate's table and the
// entry target say fx_rate. The two settings keep their names; only the portfolio ref is renamed, to
// match every other er entity's `portfolio`.
def er2db_entity exchange_rate_map     { entity: er.entity.exchange_rate,     target: { table: db.dbo.investment_fx_rate } }
def er2db_entity estate_setting_map    { entity: er.entity.estate_setting,    target: { table: db.dbo.investment_estate_setting } }
def er2db_entity portfolio_setting_map { entity: er.entity.portfolio_setting, target: { table: db.dbo.investment_portfolio_setting } }
def er2db_attribute portfolio_setting_portfolio_map { attribute: er.entity.portfolio_setting.portfolio, target: { column: db.dbo.investment_portfolio_setting.portfolio_ref } }

// ===== the provider's valuation history (IA-P3b·S3b.3, IA-C73) =====
// Same name in both layers; only the portfolio ref is renamed, as on every other er entity.
def er2db_entity portfolio_valuation_map { entity: er.entity.portfolio_valuation, target: { table: db.dbo.investment_portfolio_valuation } }
def er2db_attribute portfolio_valuation_portfolio_map { attribute: er.entity.portfolio_valuation.portfolio, target: { column: db.dbo.investment_portfolio_valuation.portfolio_ref } }

// ===== relations =====
// Explicit maps rather than an inline `binding: { fk: … }` on each relation: the lint treats having
// both as an error on both (`ported-duplicate-mapping`), and one of the two forms had to win. This
// one wins because it keeps every binding in this file.
//
// ⚑ Each `fk` is a NATURAL-key join declared in the db layer, not a database constraint — the DDL
// has no FOREIGN KEY at all, because a §13 parser cannot know a surrogate and so the importer
// carries the business key. See `db/investment.ttrm`'s joins section for what that costs a query
// that forgets `valid_to IS NULL`.
def er2db_relation portfolio_client_rel     { relation: er.relation.rel_portfolio_client,     fk: db.dbo.fk_portfolio_client }
def er2db_relation price_asset_rel          { relation: er.relation.rel_price_asset,          fk: db.dbo.fk_price_asset }
def er2db_relation transaction_portfolio_rel { relation: er.relation.rel_transaction_portfolio, fk: db.dbo.fk_transaction_portfolio }
def er2db_relation transaction_asset_rel     { relation: er.relation.rel_transaction_asset,     fk: db.dbo.fk_transaction_asset }
def er2db_relation position_portfolio_rel    { relation: er.relation.rel_position_portfolio,    fk: db.dbo.fk_position_portfolio }
def er2db_relation position_asset_rel        { relation: er.relation.rel_position_asset,        fk: db.dbo.fk_position_asset }
def er2db_relation portfolio_setting_portfolio_rel { relation: er.relation.rel_portfolio_setting_portfolio, fk: db.dbo.fk_portfolio_setting_portfolio }
def er2db_relation portfolio_valuation_portfolio_rel { relation: er.relation.rel_portfolio_valuation_portfolio, fk: db.dbo.fk_portfolio_valuation_portfolio }
